# Environment variables template for Yelp Data Engineering Platform

# Project details
PROJECT_NAME=yelp-data-engineering
ENVIRONMENT=development

# MinIO Config
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL DWH Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yelp_dwh
POSTGRES_PORT=5432

# Apache Airflow Config
AIRFLOW_IMAGE_NAME=apache/airflow:2.7.1
AIRFLOW_UID=50000
_PIP_ADDITIONAL_REQUIREMENTS=pyspark-3.4.0 boto3 psycopg2-binary great-expectations fastapi uvicorn sqlalchemy

# PySpark / JVM Config
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8080
